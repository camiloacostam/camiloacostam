---
// Closing CTA: book a call or write on WhatsApp.
import { links } from '../../data/home';
import { getProjectsPage } from '../../data/projects-page';
import { getLang } from '../../i18n/utils';

const c = getProjectsPage(getLang(Astro.currentLocale)).closing;
---
<section class="relative pt-40 pb-24 max-sm:pt-28 max-sm:pb-16">
  <div class="wrap grid grid-cols-[minmax(0,1fr)_360px] items-start gap-12 max-lg:grid-cols-1">
    <div>
      <p class="m-0 text-[13px] tracking-[.14em] text-ink-muted-dark uppercase">{c.eyebrow}</p>
      <h2 class="reveal mt-3.5 text-[80px] leading-[80px] font-medium tracking-[-0.05em] max-lg:text-[56px] max-lg:leading-[60px] max-sm:text-[40px] max-sm:leading-[44px]">
        {c.titleStart} <span class="script text-aqua">{c.titleScript}</span> {c.titleEnd}
      </h2>
      <div class="mt-10 flex flex-wrap gap-3.5">
        <a
          class="fill-btn inline-flex min-h-15 items-center gap-3 rounded-full bg-crema py-0 pr-2 pl-6.5 font-semibold text-mar no-underline"
          href={links.calendly}
          data-calendly
          data-track="agendar"
          data-track-place="proyectos"
        >
          {c.cta}
          <span class="inline-flex size-11 items-center justify-center rounded-full bg-mediterraneo text-white">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
          </span>
        </a>
        <a
          class="inline-flex min-h-15 items-center rounded-full border border-mar-line px-6.5 text-crema no-underline transition-colors duration-300 hover:border-aqua-light"
          href={links.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp"
          data-track-place="proyectos"
        >{c.whatsapp}</a>
      </div>
    </div>
    <div class="border border-white/12 bg-black/40 p-3.5">
      <div class="bg-crema p-5.5">
        <div class="flex aspect-[4/3] flex-col items-center justify-center gap-1.5 border border-dashed border-ink-muted-dark p-4 text-center text-ink-muted">
          <span class="script text-[30px] text-mediterraneo">{c.brand}</span>
          <span class="text-xs tracking-[.14em] uppercase">{c.spots}</span>
        </div>
      </div>
    </div>
  </div>
</section>
