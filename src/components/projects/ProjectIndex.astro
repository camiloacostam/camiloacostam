---
// "All projects" table: one row per portfolio project.
import { projects, projectText } from '../../data/projects';
import { getProjectsPage } from '../../data/projects-page';
import { getLang } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const { index: c } = getProjectsPage(lang);

const rows = projects.map((p, i) => {
  const x = projectText(p, lang);
  return { no: String(i + 1).padStart(2, '0'), title: p.title, kind: x.kind, client: x.client, tech: p.tech.join(' · '), year: p.year, href: p.link ?? '' };
});
const cols = 'grid-cols-[80px_minmax(0,1fr)_260px_90px_40px] max-sm:grid-cols-[40px_minmax(0,1fr)_24px] gap-4';
---
<section class="relative pt-40 max-sm:pt-28">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="reveal m-0 text-[56px] leading-[60px] font-medium tracking-[-0.04em] max-sm:text-[40px] max-sm:leading-[44px]">{c.title}</h2>
      <p class="m-0 text-sm text-ink-muted-dark">{c.count(rows.length)}</p>
    </div>
    <div class="mt-10 border-b border-mar-line">
      <div class:list={['grid border-t border-mar-line py-3 text-[11px] tracking-[.14em] text-ink-muted-dark uppercase', cols]} aria-hidden="true">
        <span>{c.cols.no}</span><span>{c.cols.project}</span><span class="max-sm:hidden">{c.cols.tools}</span><span class="max-sm:hidden">{c.cols.year}</span><span></span>
      </div>
      <ul class="m-0 list-none p-0">
        {rows.map((r) => {
          const Tag = r.href ? 'a' : 'div';
          return (
            <li>
              <Tag
                {...(r.href ? { href: r.href } : {})}
                class:list={['group grid items-center border-t border-mar-line py-6.5 text-crema no-underline transition-[background-color,padding] duration-500 ease-brand hover:bg-aqua/8 hover:pl-4 max-sm:py-5', cols]}
              >
                <span class="text-sm text-aqua-light tabular-nums">{r.no}</span>
                <span>
                  <span class="block text-[32px] leading-9 font-medium tracking-[-0.03em] max-sm:text-2xl max-sm:leading-7">{r.title}</span>
                  <span class="mt-1 block text-sm text-ink-muted-dark">{r.kind} · {r.client}</span>
                </span>
                <span class="text-sm text-ink-muted-dark max-sm:hidden">{r.tech}</span>
                <span class="text-sm text-ink-muted-dark max-sm:hidden">{r.year}</span>
                <span aria-hidden="true" class="text-xl transition-[transform,color] duration-300 group-hover:translate-x-1 group-hover:text-aqua">→</span>
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>
