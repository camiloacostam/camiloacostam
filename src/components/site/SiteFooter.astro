---
// Footer strip for the inner pages. `tone` = the background it sits on.
import { getSite } from '../../data/site';
import { links } from '../../data/home';
import { getLang } from '../../i18n/utils';

interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;
const { footer } = getSite(getLang(Astro.currentLocale));
const dark = tone === 'dark';

const social = [
  { label: 'Instagram', href: links.instagram },
  { label: 'LinkedIn',  href: links.linkedin },
  { label: 'GitHub',    href: links.github },
].filter((s) => s.href);
---
<footer
  class="wrap flex flex-wrap justify-between gap-4 border-t pt-6 pb-24 text-[13px]"
  class:list={[dark ? 'border-mar-line text-ink-muted-dark' : 'border-line text-ink-muted']}
>
  <span>{footer.copy}</span>
  <nav aria-label={footer.social} class="flex gap-3">
    {social.map((s) => (
      <a href={s.href} target="_blank" rel="noopener" class="link-u" class:list={[dark ? 'text-crema' : 'text-mar']}>{s.label}</a>
    ))}
  </nav>
</footer>
