---
// Floating glass pill nav for the inner pages. `tone` = the background it sits on.
import { getSite, type SitePage } from '../../data/site';
import { links } from '../../data/home';
import { getAlternatePath, getLang } from '../../i18n/utils';

interface Props {
  current?: SitePage;
  tone?: 'light' | 'dark';
}

const { current, tone = 'light' } = Astro.props;
const lang = getLang(Astro.currentLocale);
const { nav } = getSite(lang);
const altHref = getAlternatePath(Astro.url.pathname, lang);
const dark = tone === 'dark';
---
<header class="fixed inset-x-0 top-4 z-40 px-4" class:list={[dark ? 'on-dark' : 'on-light']}>
  <div
    class="mx-auto flex h-16 max-w-[1120px] items-center justify-between gap-4 rounded-full pr-2.5 pl-3"
    class:list={[dark ? 'glass text-crema' : 'glass-light text-mar']}
  >
    <a href={nav.links[0].href} class="flex items-center gap-2.5 no-underline" aria-label={nav.home}>
      <span class="inline-flex size-10 items-center justify-center rounded-full bg-mar font-script text-xl font-bold text-aqua" aria-hidden="true">CA</span>
      <span class="text-base font-semibold max-sm:hidden">Camilo Acosta</span>
    </a>

    <nav aria-label={nav.label} class="flex gap-7 text-[15px] font-medium max-lg:hidden">
      {nav.links.map((l) => (
        <a
          href={l.href}
          aria-current={current === l.id ? 'page' : undefined}
          class="px-0.5 py-2 no-underline opacity-80 transition-opacity duration-300 hover:opacity-100 aria-[current=page]:opacity-100"
          class:list={[dark ? 'aria-[current=page]:shadow-underline-aqua' : 'aria-[current=page]:shadow-underline-blue']}
        >{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={altHref} hreflang={lang === 'es' ? 'en' : 'es'} aria-label={nav.langAria} class="inline-flex min-h-11 items-center px-3 text-sm font-semibold no-underline opacity-80 hover:opacity-100">{nav.langLabel}</a>

      <details class="group relative lg:hidden">
        <summary class="inline-flex min-h-11 cursor-pointer list-none items-center rounded-full px-4 text-sm font-semibold [&::-webkit-details-marker]:hidden">{nav.menu}</summary>
        <nav aria-label={nav.label} class="absolute top-14 right-0 flex min-w-48 flex-col rounded-3xl bg-mar p-3 text-crema shadow-float">
          {nav.links.map((l) => (
            <a href={l.href} aria-current={current === l.id ? 'page' : undefined} class="rounded-2xl px-4 py-3 no-underline hover:bg-mar-raised aria-[current=page]:text-aqua-light">{l.label}</a>
          ))}
        </nav>
      </details>

      <a
        href={links.booking}
        data-booking
        data-track="agendar"
        data-track-place="nav"
        class="fill-btn inline-flex min-h-11 items-center rounded-full bg-mediterraneo px-5.5 text-[15px] font-semibold whitespace-nowrap text-white no-underline max-sm:hidden"
      >{nav.cta}</a>
    </div>
  </div>
</header>
