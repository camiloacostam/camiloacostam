---
import { links } from '../../data/home';
import type { BlogPageCopy } from '../../data/blog-page';

interface Props { copy: BlogPageCopy['cta']; }
const { copy } = Astro.props;
---
<div class="reveal grid grid-cols-[minmax(0,1fr)_auto] items-center gap-8 rounded-[32px] bg-mar p-12 text-crema max-lg:grid-cols-1 max-sm:p-6">
  <div>
    <p class="eyebrow m-0 text-aqua-light">{copy.eyebrow}</p>
    <h2 class="mt-3 mb-0 text-5xl leading-[52px] tracking-[-0.04em] max-sm:text-[32px] max-sm:leading-9">
      {copy.titleLead} <span class="script text-aqua">{copy.titleScript}</span>
    </h2>
    <p class="mt-3.5 mb-0 max-w-[520px] text-base text-ink-muted-dark">{copy.desc}</p>
  </div>
  <a
    href={links.booking}
    data-booking
    data-track="agendar"
    data-track-place="blog"
    class="btn fill-btn gap-3 bg-crema pr-2 text-mar"
  >
    {copy.button}
    <span class="inline-flex size-11 items-center justify-center rounded-full bg-mediterraneo text-white">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
    </span>
  </a>
</div>
