---
import { render, type CollectionEntry } from 'astro:content';
import { blogPage } from '../../data/blog-page';
import { getLang } from '../../i18n/utils';
import BlogCta from './BlogCta.astro';

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content } = await render(post);

const lang = getLang(Astro.currentLocale);
const copy = blogPage[lang];
const prefix = lang === 'en' ? '/en' : '';
const { title, date, cover, readingTime } = post.data;
const cat = post.data.category ?? post.data.badge;
const dateLabel = date.toLocaleDateString(lang === 'en' ? 'en-US' : 'es-CO', { day: 'numeric', month: 'long', year: 'numeric' });
---
<main class="pt-44 max-sm:pt-36">
  <article>
    <header class="wrap">
      <a href={`${prefix}/blog/`} class="link-u inline-flex min-h-11 items-center text-sm font-medium text-mediterraneo">{copy.post.back}</a>
      <p class="eyebrow mt-6 mb-0 tracking-[.14em]">{cat}{readingTime && ` · ${readingTime} ${copy.post.readUnit} ${copy.post.readSuffix}`}</p>
      <h1 class="mt-4 mb-0 max-w-[960px] text-[88px] leading-[84px] font-medium tracking-[-0.05em] text-balance max-lg:text-[64px] max-lg:leading-16 max-sm:text-[40px] max-sm:leading-11">{title}</h1>
      <p class="mt-8 mb-0 flex items-center gap-2.5 text-sm text-ink-muted">
        <span class="inline-flex size-8 items-center justify-center rounded-full bg-mar font-script text-base font-bold text-aqua" aria-hidden="true">CA</span>
        {copy.post.author} · <time datetime={date.toISOString()}>{dateLabel}</time>
      </p>
    </header>

    {cover && (
      <div class="wrap mt-12">
        <img src={cover} alt="" class="aspect-[16/9] w-full rounded-card object-cover" />
      </div>
    )}

    <div class="wrap mt-14">
      <div class="post-prose max-w-[68ch]">
        <Content />
      </div>
    </div>
  </article>

  <section class="pt-30 pb-24 max-sm:pt-20">
    <div class="wrap">
      <BlogCta copy={copy.cta} />
    </div>
  </section>
</main>

<style>
  @reference "../../styles/app.css";

  .post-prose :global(> :first-child) { @apply mt-0; }
  .post-prose :global(p) { @apply mt-0 mb-5 text-[19px] leading-8 text-mar max-sm:text-[17px] max-sm:leading-[27px]; }
  .post-prose :global(h2) { @apply mt-14 mb-4 text-[40px] leading-11 tracking-[-0.035em] max-sm:text-[28px] max-sm:leading-8; }
  .post-prose :global(h3) { @apply mt-10 mb-3 text-2xl leading-8 tracking-[-0.02em]; }
  .post-prose :global(ul), .post-prose :global(ol) { @apply mb-5 pl-6 text-[19px] leading-8 max-sm:text-[17px]; }
  .post-prose :global(ul) { @apply list-disc; }
  .post-prose :global(ol) { @apply list-decimal; }
  .post-prose :global(li) { @apply mb-2; }
  .post-prose :global(strong) { @apply font-semibold; }
  .post-prose :global(a) { @apply text-mediterraneo underline underline-offset-4; }
  .post-prose :global(blockquote) { @apply my-8 border-l-4 border-aqua pl-6 text-2xl leading-8 text-ink-muted; }
  .post-prose :global(code) { @apply rounded bg-cielo-soft px-1.5 py-0.5 text-[0.9em] text-mediterraneo; }
  .post-prose :global(pre) { @apply my-8 overflow-x-auto rounded-2xl bg-mar p-6 text-crema; }
  .post-prose :global(pre code) { @apply bg-transparent p-0 text-crema; }
  .post-prose :global(img) { @apply my-8 h-auto max-w-full rounded-2xl; }
  .post-prose :global(hr) { @apply my-12 border-line; }
</style>
