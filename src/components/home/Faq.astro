---
import Icon from './Icon.astro';
import { getHome, links } from '../../data/home';
import { getLang } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const c    = getHome(lang).faq;
const wa   = `${links.whatsapp}?text=${encodeURIComponent(c.whatsappText)}`;
---
<section id="preguntas" class="pb-40 max-sm:pb-[88px]" data-nav="light">
  <div class="wrap grid grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] grid-rows-[auto_1fr] gap-x-16 max-lg:grid-cols-1 max-sm:px-5!">
    <h2 class="reveal col-start-1 row-start-1 text-[56px] leading-[60px] tracking-[-0.035em] max-sm:text-[40px] max-sm:leading-[44px] max-sm:tracking-[-0.04em]">{c.title}</h2>

    <div class="col-start-2 row-span-2 row-start-1 border-b border-line max-lg:col-start-1 max-lg:row-span-1 max-lg:row-start-2 max-lg:mt-8 max-sm:mt-6">
      {c.items.map(([q, a], i) => (
        <details class="group/faq border-t border-line" name="faq" open={i === 0}>
          <summary class="flex min-h-[72px] cursor-pointer list-none items-center justify-between gap-4 py-5 text-xl leading-7 font-medium text-mar focus-visible:rounded-xl max-sm:min-h-16 max-sm:gap-3 max-sm:py-4 max-sm:text-[17px] max-sm:leading-6 [&::-webkit-details-marker]:hidden">{q}<span class="flex size-10 shrink-0 items-center justify-center rounded-full border border-line text-mar transition-all duration-[350ms] group-open/faq:rotate-45 group-open/faq:border-mediterraneo group-open/faq:bg-mediterraneo group-open/faq:text-white max-sm:size-[34px]"><Icon name="plus" size={16} /></span></summary>
          <p class="pr-12 pb-6 text-base leading-[26px] text-ink-muted max-sm:pr-9 max-sm:pb-[18px] max-sm:text-[15px] max-sm:leading-[23px]">{a}</p>
        </details>
      ))}
    </div>

    <div class="reveal col-start-1 row-start-2 mt-10 max-w-[360px] self-start rounded-3xl bg-crema-raised p-6 max-lg:row-start-3 max-sm:mt-7 max-sm:max-w-none max-sm:p-5">
      <p class="text-lg leading-[27px] max-sm:text-[17px] max-sm:leading-[25px]">{c.moreTitle}</p>
      <p class="mt-1 text-[15px] leading-[23px] text-ink-muted max-sm:mt-0.5 max-sm:text-sm max-sm:leading-[21px]">{c.moreDesc}</p>
      <a class="pill fill-btn breathe mt-[18px] inline-flex min-h-[52px] items-center justify-center gap-2.5 rounded-full bg-mar px-6 text-base font-semibold whitespace-nowrap text-white no-underline max-sm:mt-3.5 max-sm:w-full" href={wa} target="_blank" rel="noopener noreferrer" data-track="whatsapp" data-track-place="faq">
        <Icon name="whatsapp" />{c.moreCta}
      </a>
    </div>
  </div>
</section>
