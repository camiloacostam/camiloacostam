---
import Icon from './Icon.astro';
import { getHome, links } from '../../data/home';
import { getLang } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const home = getHome(lang);
const c    = home.process;
---
<section id="proceso" class="process-sec scale-in" data-nav="dark">
  <div class="wrap">
    <h2 class="h-section reveal process-title">{c.title}</h2>
    <ol class="steps">
      {c.steps.map((s, i) => (
        <li class:list={['step reveal', { 'step--last': i === c.steps.length - 1, 'step--first': i === 0 }]}>
          <p class="step-day">{s.day}</p>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-desc">{s.desc}</p>
        </li>
      ))}
    </ol>
    <div class="process-cta reveal">
      <p class="ready">
        {c.readyStart} <span class="ready-date" data-ready-date data-locale={home.locale} data-prefix={c.readyPrefix}>{c.readyFallback}</span>.
      </p>
      <a class="btn btn--aqua pill fill-btn breathe" href={links.calendly} data-calendly data-track="agendar" data-track-place="proceso">
        {c.cta}<Icon name="arrow-right" />
      </a>
    </div>
  </div>
</section>

<style>
  .process-sec { background: var(--mar); color: var(--crema); padding: 160px 0; }
  .process-title { max-width: 820px; }

  .steps { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; margin-top: 96px; }
  .step { border-top: 1px solid var(--mar-line); padding-top: 24px; }
  .step--last { border-top-color: var(--aqua); }
  .step-day { font-size: 13px; line-height: 20px; color: var(--aqua-light); }
  .step-title { margin-top: 16px; font-size: 24px; line-height: 30px; }
  .step-desc { margin-top: 10px; font-size: 15px; line-height: 24px; color: var(--ink-muted-dark); }

  .process-cta {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px;
    margin-top: 96px; padding-top: 40px; border-top: 1px solid var(--mar-line);
  }
  .ready { font-size: 28px; line-height: 36px; letter-spacing: -0.02em; }
  .ready-date { color: var(--aqua-light); }

  @media (max-width: 960px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Móvil: línea de tiempo vertical */
  @media (max-width: 640px) {
    .process-sec { padding: 88px 0 80px; border-radius: 32px 32px 0 0; }
    .wrap { padding: 0 20px; }
    .steps { display: block; position: relative; margin-top: 40px; padding-left: 28px; }
    .steps::before {
      content: ''; position: absolute; left: 5px; top: 6px; bottom: 6px; width: 1px;
      background: linear-gradient(var(--aqua), var(--mar-line));
    }
    .step { position: relative; border-top: 0; padding: 0 0 28px; }
    .step--last { padding-bottom: 0; }
    .step::before {
      content: ''; position: absolute; left: -28px; top: 4px; width: 11px; height: 11px; border-radius: 9999px;
      background: var(--mar); border: 1px solid var(--aqua-light);
    }
    .step--first::before, .step--last::before { background: var(--aqua); border-color: var(--aqua); }
    .step-day { font-size: 12px; line-height: 18px; }
    .step-title { margin-top: 4px; font-size: 20px; line-height: 26px; }
    .step-desc { margin-top: 4px; font-size: 14px; line-height: 21px; }
    .process-cta { display: block; margin-top: 40px; padding-top: 28px; }
    .ready { font-size: 22px; line-height: 30px; }
    .process-cta .btn { margin-top: 18px; width: 100%; min-height: 54px; }
  }
</style>
