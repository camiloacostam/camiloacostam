---
import Icon from './Icon.astro';
import { getHome, links } from '../../data/home';
import { getLang } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const home = getHome(lang);
const c    = home.process;
---
<section id="proceso" class="scale-in bg-mar py-40 text-crema max-sm:rounded-t-[32px] max-sm:pt-[88px] max-sm:pb-20" data-nav="dark">
  <div class="wrap max-sm:px-5!">
    <h2 class="h-section reveal max-w-[820px]">{c.title}</h2>
    <!-- Móvil: línea de tiempo vertical -->
    <ol class="mt-24 grid list-none grid-cols-4 gap-8 max-lg:grid-cols-2 max-sm:relative max-sm:mt-10 max-sm:block max-sm:pl-7 max-sm:before:absolute max-sm:before:top-1.5 max-sm:before:bottom-1.5 max-sm:before:left-[5px] max-sm:before:w-px max-sm:before:bg-linear-to-b max-sm:before:from-aqua max-sm:before:to-mar-line max-sm:before:content-['']">
      {c.steps.map((s, i) => {
        const edge = i === 0 || i === c.steps.length - 1;
        return (
          <li
            class:list={[
              'reveal relative border-t pt-6',
              'max-sm:border-t-0 max-sm:pt-0 max-sm:pb-7 max-sm:last:pb-0',
              "max-sm:before:absolute max-sm:before:top-1 max-sm:before:-left-7 max-sm:before:size-[11px] max-sm:before:rounded-full max-sm:before:border max-sm:before:content-['']",
              i === c.steps.length - 1 ? 'border-aqua' : 'border-mar-line',
              edge ? 'max-sm:before:border-aqua max-sm:before:bg-aqua' : 'max-sm:before:border-aqua-light max-sm:before:bg-mar',
            ]}
          >
            <p class="text-[13px] leading-5 text-aqua-light max-sm:text-xs max-sm:leading-[18px]">{s.day}</p>
            <h3 class="mt-4 text-2xl leading-[30px] max-sm:mt-1 max-sm:text-xl max-sm:leading-[26px]">{s.title}</h3>
            <p class="mt-2.5 text-[15px] leading-6 text-ink-muted-dark max-sm:mt-1 max-sm:text-sm max-sm:leading-[21px]">{s.desc}</p>
          </li>
        );
      })}
    </ol>
    <div class="reveal mt-24 flex flex-wrap items-center justify-between gap-6 border-t border-mar-line pt-10 max-sm:mt-10 max-sm:block max-sm:pt-7">
      <p class="text-[28px] leading-9 tracking-[-0.02em] max-sm:text-[22px] max-sm:leading-[30px]">
        {c.readyStart} <span class="text-aqua-light" data-ready-date data-locale={home.locale} data-prefix={c.readyPrefix}>{c.readyFallback}</span>.
      </p>
      <a class="btn pill fill-btn breathe bg-aqua text-mar max-sm:mt-[18px] max-sm:min-h-[54px] max-sm:w-full" href={links.booking} data-booking data-track="agendar" data-track-place="proceso">
        {c.cta}<Icon name="arrow-right" />
      </a>
    </div>
  </div>
</section>
