---
import Icon from './Icon.astro';
import { getHome, links } from '../../data/home';
import { getLang, getAlternatePath } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const c    = getHome(lang).nav;
const altPath = getAlternatePath(Astro.url.pathname, lang);

const socials = [
  links.instagram && { label: 'Instagram', href: links.instagram },
  { label: 'LinkedIn', href: links.linkedin },
  { label: 'GitHub',   href: links.github },
].filter(Boolean) as { label: string; href: string }[];
---
<header
  class="on-dark group/nav fixed inset-x-0 top-4 z-40 px-4 max-sm:top-3 max-sm:px-3"
  id="nav"
  data-cta-default={c.cta}
  data-cta-map={JSON.stringify(c.ctaBySection)}
>
  <div class="glass group-[.on-light]/nav:glass-light relative mx-auto flex h-16 max-w-[1120px] items-center justify-between gap-4 overflow-hidden rounded-full py-0 pr-2.5 pl-3 transition-[background,border-color,box-shadow] duration-[450ms] max-sm:h-14 max-sm:pr-1.5 max-sm:pl-2">
    <div class="pointer-events-none absolute inset-x-8 bottom-0 h-0.5 rounded-full bg-cielo/18 max-sm:inset-x-6" aria-hidden="true"><div class="h-full w-full origin-left rounded-full bg-linear-to-r from-mediterraneo to-aqua transition-transform duration-150 ease-linear [transform:scaleX(0)]" id="nav-progress"></div></div>

    <a class="flex items-center gap-2.5 text-white no-underline transition-colors duration-[450ms] group-[.on-light]/nav:text-mar max-sm:gap-2" href="#inicio">
      <span class="inline-flex size-10 items-center justify-center rounded-full bg-mar font-script text-xl font-bold text-aqua">CA</span>
      <span class="text-base font-semibold tracking-[-0.01em] max-sm:text-[15px]">Camilo Acosta</span>
    </a>

    <nav class="flex gap-7 text-[15px] font-medium max-lg:hidden" aria-label={c.label}>
      {c.links.map((l) => (
        <a
          class="relative px-0.5 py-2 text-crema no-underline opacity-90 transition-[opacity,color] duration-[450ms] after:absolute after:bottom-0 after:left-1/2 after:size-1 after:-translate-x-1/2 after:translate-y-1.5 after:scale-0 after:rounded-full after:bg-aqua after:transition-transform after:duration-[350ms] after:ease-brand after:content-[''] hover:text-white hover:opacity-100 hover:after:scale-100 group-[.on-light]/nav:text-mar group-[.on-light]/nav:hover:text-mar"
          href={l.href}
        >{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a class="p-2.5 text-[13px] font-semibold text-white no-underline opacity-85 transition-colors duration-[450ms] group-[.on-light]/nav:text-mar max-sm:hidden" href={altPath} hreflang={lang === 'es' ? 'en' : 'es'} aria-label={c.langAria}>{c.langLabel}</a>
      <a
        class="pill fill-btn inline-flex min-h-11 items-center rounded-full bg-mediterraneo px-[22px] text-[15px] font-semibold whitespace-nowrap text-white no-underline max-sm:hidden"
        href={links.calendly}
        data-calendly
        data-nav-cta
        data-track="agendar"
        data-track-place="nav"
      ><span class="cta-label" data-cta-label>{c.cta}</span></a>
      <button
        class="hidden size-11 cursor-pointer items-center justify-center rounded-full border-0 bg-mediterraneo text-white active:scale-[.97] max-lg:inline-flex"
        type="button"
        aria-label={c.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="menu-open"
      ><Icon name="menu" /></button>
    </div>
  </div>
</header>

<div class="fixed inset-0 z-[60] flex flex-col bg-mar/82 px-6 pt-6 pb-8 text-crema backdrop-blur-[24px] backdrop-saturate-[160%]" id="mobile-menu" hidden>
  <div class="flex h-14 items-center justify-between">
    <span class="script text-[26px] text-aqua">Camilo Acosta</span>
    <button class="inline-flex size-11 cursor-pointer items-center justify-center rounded-full border border-white/30 bg-transparent text-white active:scale-[.97]" type="button" aria-label={c.closeMenu} id="menu-close"><Icon name="close" /></button>
  </div>
  <nav class="mt-12 flex flex-col gap-1.5" aria-label={c.label}>
    {c.links.map((l) => (
      <a class="text-[40px] leading-[52px] font-medium tracking-[-0.03em] text-crema no-underline" href={l.href} data-menu-link data-menu-close>{l.label}</a>
    ))}
  </nav>
  <div class="mt-auto flex flex-col gap-3">
    <a class="btn bg-aqua text-mar" href={links.calendly} data-calendly data-track="agendar" data-track-place="menu" data-menu-close>{c.menuCta}</a>
    <div class="flex justify-between text-[13px] text-ink-muted-dark">
      <span>
        {socials.map((s, i) => (
          <>{i > 0 && ' · '}<a class="text-inherit no-underline" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></>
        ))}
      </span>
      <a class="text-inherit no-underline" href={altPath} hreflang={lang === 'es' ? 'en' : 'es'}>ES / EN</a>
    </div>
  </div>
</div>
