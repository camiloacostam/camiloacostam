---
import { getHome, isPending, links } from '../../data/home';
import { getLang } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const c    = getHome(lang).statement;
---
<section class="pt-40 pb-32 max-sm:pt-[88px] max-sm:pb-[72px]" data-nav="light">
  <div class="wrap grid grid-cols-[minmax(0,1fr)_220px] items-start gap-16 max-lg:grid-cols-1 max-sm:gap-10 max-sm:px-5!">
    <div>
      <p class="reveal text-[48px] leading-[58px] tracking-[-0.025em] max-lg:text-[40px] max-lg:leading-[50px] max-sm:text-[28px] max-sm:leading-9">{c.textStart} <span class="text-mediterraneo">{c.highlight}</span>{c.textEnd}</p>
      <ol class="reveal mt-20 grid list-none grid-cols-3 gap-10 max-sm:mt-10 max-sm:grid-cols-1 max-sm:gap-0">
        {c.pains.map((p, i) => (
          <li class="border-t border-line pt-5 max-sm:flex max-sm:gap-4 max-sm:py-[18px] max-sm:last:border-b">
            <span class="text-[13px] text-ink-muted max-sm:pt-[3px] max-sm:text-xs">{String(i + 1).padStart(2, '0')}</span>
            <p class="mt-2 text-lg leading-[27px] max-sm:mt-0 max-sm:text-base max-sm:leading-6">{p}</p>
          </li>
        ))}
      </ol>
    </div>
    <div class="flex flex-col items-start gap-8 max-sm:flex-row-reverse max-sm:items-center max-sm:gap-5">
      <p class="text-[15px] leading-6 text-ink-muted max-sm:text-sm max-sm:leading-[21px]">{c.aside}{!isPending(c.asideStats) && ` ${c.asideStats}`}</p>
      <div class="magnet max-sm:shrink-0" data-magnet>
        <a class="circle-btn fill-btn breathe size-[180px] bg-mar text-[17px] leading-6 text-crema max-sm:size-[132px] max-sm:text-[15px] max-sm:leading-5" href={links.booking} data-booking data-track="agendar" data-track-place="presentacion">{c.button[0]}<br />{c.button[1]}</a>
      </div>
    </div>
  </div>
</section>
