---
import Icon from './Icon.astro';
import { getHome, links } from '../../data/home';
import { getLang } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const home = getHome(lang);
const c    = home.mobileBar;
const wa   = `${links.whatsapp}?text=${encodeURIComponent(home.closing.whatsappText)}`;
---
<!-- Solo móvil. home.ts la oculta (is-hidden) al llegar al cierre y (hidden) con el menú abierto -->
<div
  class="fixed right-3 bottom-3.5 left-3 z-[39] hidden h-16 items-center gap-2 rounded-full border border-white/45 bg-linear-135 from-mar/72 to-mar/55 p-1.5 shadow-glass backdrop-blur-[22px] backdrop-saturate-[180%] transition-[transform,opacity] duration-[450ms] ease-brand max-sm:flex [&.is-hidden]:pointer-events-none [&.is-hidden]:translate-y-[120%] [&.is-hidden]:opacity-0"
  id="mobile-bar"
>
  <a class="flex h-[52px] grow items-center justify-center rounded-full bg-aqua text-[15px] font-semibold text-mar no-underline active:scale-[.97]" href={links.calendly} data-calendly data-track="agendar" data-track-place="barra-movil">
    <span class="cta-label" data-cta-label data-cta-default={c.cta}>{c.cta}</span>
  </a>
  <a class="flex size-[52px] shrink-0 items-center justify-center rounded-full bg-disponible text-mar active:scale-[.97]" href={wa} target="_blank" rel="noopener noreferrer" aria-label={c.whatsappAria} data-track="whatsapp" data-track-place="barra-movil">
    <Icon name="whatsapp" size={22} />
  </a>
</div>
