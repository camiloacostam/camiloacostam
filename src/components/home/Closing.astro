---
import { Image } from 'astro:assets';
import avatar from '../../assets/home/camilo.webp';
import LeadForm from './LeadForm.astro';
import { getHome, links } from '../../data/home';
import { getLang } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const home = getHome(lang);
const c    = home.closing;

const waHref   = `${links.whatsapp}?text=${encodeURIComponent(c.whatsappText)}`;
const mailHref = `mailto:${links.email}?subject=${encodeURIComponent(c.emailSubject)}`;

const socials = [
  links.instagram && { label: 'Instagram', href: links.instagram },
  { label: 'LinkedIn', href: links.linkedin },
  { label: 'GitHub',   href: links.github },
].filter(Boolean) as { label: string; href: string }[];
---
<section id="contacto" class="closing" data-nav="dark" data-nav-offset="120">
  <div class="curve" aria-hidden="true"></div>
  <div class="blob blob--c" aria-hidden="true"></div>

  <div class="wrap closing-inner">
    <div class="closing-head">
      <Image src={avatar} alt="" width={176} height={176} class="closing-avatar" />
      <h2 class="closing-title">{c.title}</h2>
    </div>

    <div class="closing-line">
      <div class="magnet closing-magnet" data-magnet>
        <a class="circle-btn fill-btn breathe closing-btn" href={links.calendly} data-calendly data-track="agendar" data-track-place="cierre">{c.button[0]}<br />{c.button[1]}</a>
      </div>
    </div>

    <LeadForm />

    <div class="contact-links">
      <a class="btn btn--line pill" href={mailHref} data-track="email" data-track-place="cierre">{links.email}</a>
      <a class="btn btn--line pill" href={waHref} target="_blank" rel="noopener noreferrer" data-track="whatsapp" data-track-place="cierre">{c.whatsapp}</a>
    </div>

    <footer class="closing-foot">
      <div class="foot-meta">
        <div><p class="foot-label">{c.versionLabel}</p><p>{c.version}</p></div>
        <div>
          <p class="foot-label">{c.timeLabel}</p>
          <p><span data-local-time data-locale={home.locale}>--:--</span> {c.timeCity}</p>
        </div>
      </div>
      <div>
        <p class="foot-label">{c.socialLabel}</p>
        <div class="foot-social">
          {socials.map((s) => <a class="link-u" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
        </div>
      </div>
    </footer>
  </div>
</section>

<style>
  .closing { position: relative; background: var(--mar); color: var(--crema); padding: 200px 0 64px; overflow: hidden; }
  .curve { position: absolute; left: -10%; right: -10%; top: -120px; height: 240px; border-radius: 0 0 50% 50%; background: var(--crema); }
  .blob--c { width: 520px; height: 520px; right: -140px; bottom: -120px; background: var(--mediterraneo); opacity: .5; }
  .closing-inner { position: relative; }

  .closing-head { display: flex; align-items: center; gap: 24px; }
  .closing-avatar {
    width: 88px; height: 88px; border-radius: 9999px; flex-shrink: 0; object-fit: cover;
    object-position: 50% 12%; background: var(--cielo);
  }
  .closing-title { font-size: 96px; line-height: 96px; letter-spacing: -0.045em; }

  .closing-line { position: relative; margin-top: 72px; border-top: 1px solid var(--mar-line); }
  .closing-magnet { position: absolute; right: 8%; top: -100px; }
  .closing-btn { width: 200px; height: 200px; background: var(--mediterraneo); color: #FFFFFF; font-size: 18px; line-height: 25px; }


  .contact-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 40px; }
  .contact-links .btn { font-weight: 400; }

  .closing-foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px;
    margin-top: 160px; font-size: 13px; line-height: 20px; color: var(--ink-muted-dark);
  }
  .closing-foot p:not(.foot-label) { color: var(--crema); }
  .foot-meta { display: flex; gap: 48px; flex-wrap: wrap; }
  .foot-label { margin-bottom: 8px; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
  .foot-social { display: flex; gap: 20px; }
  .foot-social a { color: var(--crema); }

  @media (max-width: 960px) {
    .closing-title { font-size: 64px; line-height: 64px; }
  }

  @media (max-width: 640px) {
    .closing { padding: 120px 0 48px; }
    .wrap { padding: 0 20px; }
    .curve { left: -20%; right: -20%; top: -60px; height: 120px; }
    .blob--c { width: 320px; height: 320px; right: -120px; bottom: 80px; }
    .closing-head { gap: 14px; }
    .closing-avatar { width: 64px; height: 64px; }
    .closing-title { font-size: 46px; line-height: 46px; }
    .closing-line { margin-top: 96px; height: 1px; }
    .closing-magnet { right: 0; top: -80px; }
    .closing-btn { width: 160px; height: 160px; font-size: 16px; line-height: 21px; }
    .contact-links { flex-direction: column; gap: 10px; margin-top: 28px; }
    .contact-links .btn { min-height: 54px; }
    .closing-foot { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 64px; }
    .foot-meta { display: contents; }
    .closing-foot > div:last-child { grid-column: span 2; }
    .foot-label { margin-bottom: 6px; font-size: 10px; }
  }
</style>
