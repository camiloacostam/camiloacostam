---
import { Image } from 'astro:assets';
import avatar from '../../assets/home/camilo.webp';
import LeadForm from './LeadForm.astro';
import { getHome, links } from '../../data/home';
import { getLang } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const home = getHome(lang);
const c    = home.closing;

const waHref   = `${links.whatsapp}?text=${encodeURIComponent(c.whatsappText)}`;
const mailHref = `mailto:${links.email}?subject=${encodeURIComponent(c.emailSubject)}`;

const socials = [
  links.instagram && { label: 'Instagram', href: links.instagram },
  { label: 'LinkedIn', href: links.linkedin },
  { label: 'GitHub',   href: links.github },
].filter(Boolean) as { label: string; href: string }[];

const footLabel = 'mb-2 text-[11px] uppercase tracking-[.08em] max-sm:mb-1.5 max-sm:text-[10px]';
---
<section id="contacto" class="relative overflow-hidden bg-mar pt-[200px] pb-16 text-crema max-sm:pt-[120px] max-sm:pb-12" data-nav="dark" data-nav-offset="120">
  <div class="absolute -inset-x-[10%] -top-[120px] h-60 rounded-b-[50%] bg-crema max-sm:-inset-x-[20%] max-sm:-top-[60px] max-sm:h-[120px]" aria-hidden="true"></div>
  <div class="blob -right-[140px] -bottom-[120px] size-[520px] bg-mediterraneo opacity-50! max-sm:-right-[120px] max-sm:bottom-20 max-sm:size-80" aria-hidden="true"></div>

  <div class="wrap relative max-sm:px-5!">
    <div class="flex items-center gap-6 max-sm:gap-3.5">
      <Image src={avatar} alt="" width={176} height={176} class="size-[88px] shrink-0 rounded-full bg-cielo object-cover object-[50%_12%] max-sm:size-16" />
      <h2 class="text-[96px] leading-[96px] tracking-[-0.045em] max-lg:text-[64px] max-lg:leading-[64px] max-sm:text-[46px] max-sm:leading-[46px]">{c.title}</h2>
    </div>

    <div class="relative mt-[72px] border-t border-mar-line max-sm:mt-24 max-sm:h-px">
      <div class="magnet absolute top-[-100px] right-[8%] max-sm:top-[-80px] max-sm:right-0" data-magnet>
        <a class="circle-btn fill-btn breathe size-[200px] bg-mediterraneo text-lg leading-[25px] text-white max-sm:size-40 max-sm:text-base max-sm:leading-[21px]" href={links.calendly} data-calendly data-track="agendar" data-track-place="cierre">{c.button[0]}<br />{c.button[1]}</a>
      </div>
    </div>

    <LeadForm />

    <div class="mt-10 flex flex-wrap gap-3 max-sm:mt-7 max-sm:flex-col max-sm:gap-2.5">
      <a class="btn pill border border-mar-line font-normal! text-crema max-sm:min-h-[54px]" href={mailHref} data-track="email" data-track-place="cierre">{links.email}</a>
      <a class="btn pill border border-mar-line font-normal! text-crema max-sm:min-h-[54px]" href={waHref} target="_blank" rel="noopener noreferrer" data-track="whatsapp" data-track-place="cierre">{c.whatsapp}</a>
    </div>

    <footer class="mt-40 flex flex-wrap items-end justify-between gap-6 text-[13px] leading-5 text-ink-muted-dark max-sm:mt-16 max-sm:grid max-sm:grid-cols-2 max-sm:gap-5">
      <div class="flex flex-wrap gap-12 max-sm:contents">
        <div><p class={footLabel}>{c.versionLabel}</p><p class="text-crema">{c.version}</p></div>
        <div>
          <p class={footLabel}>{c.timeLabel}</p>
          <p class="text-crema"><span data-local-time data-locale={home.locale}>--:--</span> {c.timeCity}</p>
        </div>
      </div>
      <div class="max-sm:col-span-2">
        <p class={footLabel}>{c.socialLabel}</p>
        <div class="flex gap-5">
          {socials.map((s) => <a class="link-u text-crema" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
        </div>
      </div>
    </footer>
  </div>
</section>
