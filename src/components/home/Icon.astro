---
type Name = 'arrow-right' | 'arrow-left' | 'arrow-up-right' | 'whatsapp' | 'plus' | 'menu' | 'close';

interface Props {
  name: Name;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 18, class: className, strokeWidth = 2 } = Astro.props;

const paths: Record<Name, string[]> = {
  'arrow-right':    ['M5 12h14', 'm13 6 6 6-6 6'],
  'arrow-left':     ['M19 12H5', 'm11 18-6-6 6-6'],
  'arrow-up-right': ['M7 7h10v10', 'M7 17 17 7'],
  'whatsapp':       ['M7.9 20A9 9 0 1 0 4 16.1L2 22Z'],
  'plus':           ['M12 5v14', 'M5 12h14'],
  'menu':           ['M4 9h16', 'M4 15h10'],
  'close':          ['M6 6l12 12', 'M18 6 6 18'],
};
---
<svg
  class={className}
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {paths[name].map((d) => <path d={d} />)}
</svg>
