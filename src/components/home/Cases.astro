---
import Icon from './Icon.astro';
import { getHome, links } from '../../data/home';
import { getLang } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const c    = getHome(lang).cases;
const total = String(c.items.length).padStart(2, '0');
const allProjects = lang === 'en' ? '/en/proyectos/' : '/proyectos/';

// Colores por tono: franja, captura (placeholder) y botón de acción
const tones = {
  mar:   { strip: 'bg-mar text-crema',                       media: 'bg-linear-160 from-mediterraneo to-mar-raised text-ink-muted-dark', action: 'bg-crema text-mar' },
  cielo: { strip: 'bg-cielo text-mar',                       media: 'bg-linear-160 from-cielo-soft to-cielo text-mediterraneo',          action: 'bg-mar text-crema' },
  crema: { strip: 'border-line bg-crema-raised text-mar',    media: 'bg-linear-160 from-crema to-line text-ink-muted',                   action: 'bg-mar text-crema' },
  aqua:  { strip: 'bg-aqua text-mar',                        media: '',                                                                  action: 'bg-mar text-crema' },
} as const;
---
<section id="proyectos" class="pb-40 max-sm:pb-20" data-nav="light">
  <div class="wrap">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6 max-sm:mb-6 max-sm:flex-nowrap max-sm:px-1">
      <div>
        <p class="eyebrow">{c.eyebrow}</p>
        <h2 class="h-section reveal mt-3 max-sm:mt-2">{c.title}</h2>
      </div>
      <div class="flex items-center gap-4">
        <span class="text-sm tabular-nums text-ink-muted max-sm:pb-1.5 max-sm:text-[13px]" data-cases-counter aria-live="polite">01 / {total}</span>
        <button class="inline-flex size-[52px] cursor-pointer items-center justify-center rounded-full border border-line bg-transparent text-mar transition-[background,color,border-color] duration-300 hover:border-mar hover:bg-mar hover:text-crema disabled:pointer-events-none disabled:opacity-35 max-sm:hidden" type="button" data-cases-prev aria-label={c.prev}><Icon name="arrow-left" /></button>
        <button class="inline-flex size-[52px] cursor-pointer items-center justify-center rounded-full border border-line bg-transparent text-mar transition-[background,color,border-color] duration-300 hover:border-mar hover:bg-mar hover:text-crema disabled:pointer-events-none disabled:opacity-35 max-sm:hidden" type="button" data-cases-next aria-label={c.next}><Icon name="arrow-right" /></button>
      </div>
    </div>

    <div class="group/cases relative mr-[calc(50%-50vw)] max-sm:mx-[-16px]" data-cases>
      <!-- Sin scroll-behavior: smooth: con snap, Chrome hace un scroll inicial y deja de medir el LCP -->
      <div class="flex snap-x snap-proximity gap-3 overflow-x-auto pr-10 pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden max-sm:gap-2 max-sm:px-5" data-cases-track>
        {c.items.map((p, i) => {
          const num = String(i + 1).padStart(2, '0');
          const tone = tones[p.tone];
          const ctaAttrs = p.cta
            ? { 'data-booking': '', 'data-track': 'agendar', 'data-track-place': 'casos', 'data-cta': '' }
            : {};
          return (
            <a
              class:list={[
                'group/strip relative h-[560px] shrink-0 grow-0 basis-[180px] snap-start overflow-hidden rounded-[28px] border border-transparent no-underline transition-[flex-basis] duration-[750ms] ease-brand',
                '[&.is-open]:basis-[760px] max-lg:h-[480px] max-lg:basis-[120px] max-lg:[&.is-open]:basis-[520px]',
                'max-sm:h-[420px] max-sm:basis-16 max-sm:rounded-[22px] max-sm:duration-700 max-sm:[&.is-open]:basis-[272px]',
                'pointer-fine:group-[.show-cursor]/cases:[&.is-open:not([data-cta])]:cursor-none',
                tone.strip,
                { 'is-open': i === 0 },
              ]}
              href={p.href}
              data-strip
              {...ctaAttrs}
            >
              <div class="pointer-events-none absolute inset-0 flex flex-col items-start justify-between p-6 transition-opacity duration-300 group-[.is-open]/strip:opacity-0 max-sm:items-center max-sm:px-0 max-sm:py-[18px]" aria-hidden="true">
                <span class="text-[13px] font-semibold max-sm:text-xs">{num}</span>
                <span class="rotate-180 text-[30px] leading-[34px] font-medium tracking-[-0.02em] whitespace-nowrap [writing-mode:vertical-rl] max-sm:text-[22px] max-sm:leading-[26px]">{p.name}</span>
              </div>
              <div class="absolute inset-0 flex flex-col justify-end opacity-0 transition-opacity duration-[450ms] group-[.is-open]/strip:opacity-100 group-[.is-open]/strip:delay-[250ms]">
                <div
                  class:list={[
                    'absolute flex items-center justify-center text-center transition-transform duration-[900ms] ease-brand group-hover/strip:scale-[1.03]',
                    p.cta
                      ? 'top-[-60px] right-[-60px] size-80 rounded-full bg-white/35 text-[0px] max-sm:top-[-50px] max-sm:right-[-50px] max-sm:size-[220px]'
                      : 'inset-x-6 top-6 bottom-[150px] rounded-[18px] p-4 text-sm max-sm:inset-x-3.5 max-sm:top-3.5 max-sm:bottom-[186px] max-sm:rounded-[14px] max-sm:p-3 max-sm:text-xs',
                    tone.media,
                  ]}
                >{p.media}</div>
                <div class="relative flex flex-wrap items-end justify-between gap-6 p-8 max-sm:block max-sm:p-[18px]">
                  <div class="max-w-[420px]">
                    <p class="text-xs leading-[18px] tracking-[.08em] uppercase opacity-75 max-sm:text-[11px]">{num} · {p.cat}</p>
                    <p class="mt-2 text-[40px] leading-[44px] font-medium tracking-[-0.03em] max-sm:mt-1.5 max-sm:text-2xl max-sm:leading-7">{p.title}</p>
                    <p class="mt-2 text-[15px] leading-[23px] opacity-80 max-sm:mt-1.5 max-sm:text-[13px] max-sm:leading-[19px]">{p.desc}</p>
                  </div>
                  <span class:list={['inline-flex min-h-12 shrink-0 items-center rounded-full px-[22px] text-[15px] font-semibold max-sm:mt-3 max-sm:min-h-10 max-sm:px-4 max-sm:text-sm', tone.action]}>{p.cta ? c.actionCta : c.actionCase}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
      <!-- Cursor "Ver caso" de vidrio: solo con puntero fino (lo mueve home.ts) -->
      <div class="pointer-events-none absolute top-0 left-0 z-[6] -mt-12 -ml-12 flex size-24 scale-[.6] items-center justify-center rounded-full border border-white/50 bg-white/22 text-[13px] font-semibold text-white opacity-0 shadow-[0_10px_30px_-10px_rgb(10_35_66/.5)] backdrop-blur-[14px] backdrop-saturate-[160%] transition-[opacity,scale,left,top] duration-200 ease-brand group-[.show-cursor]/cases:scale-100 group-[.show-cursor]/cases:opacity-100 max-sm:hidden" aria-hidden="true" data-cases-cursor>{c.cursor}</div>
    </div>

    <div class="mt-7 h-0.5 max-w-80 rounded-full bg-line max-sm:hidden"><div class="h-full origin-left rounded-full bg-mediterraneo transition-transform duration-200 [transform:scaleX(.12)]" data-cases-bar></div></div>
    <p class="mx-1 mt-3 hidden text-xs leading-[18px] text-ink-muted max-sm:block">{c.hint}</p>

    <div class="reveal mt-14 flex flex-wrap items-center justify-between gap-6 rounded-full bg-crema-raised py-7 pr-7 pl-9 max-lg:rounded-[32px] max-sm:mt-7 max-sm:block max-sm:rounded-3xl max-sm:p-5">
      <p class="text-2xl leading-8 tracking-[-0.02em] max-sm:text-xl max-sm:leading-[27px]">{c.barText}</p>
      <div class="flex flex-wrap items-center gap-4 max-sm:mt-3.5">
        <a class="link-u text-[15px] text-mar max-sm:hidden" href={allProjects}>{c.barAll}</a>
        <a class="btn pill fill-btn breathe bg-mediterraneo text-white max-sm:min-h-[52px] max-sm:w-full" href={links.booking} data-booking data-track="agendar" data-track-place="casos-barra">
          {c.barCta}<Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </div>
</section>
