---
import Icon from './Icon.astro';
import { getHome, links } from '../../data/home';
import { NEEDS, NICHES, TIMELINES } from '../../data/lead';
import { getLang } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const f    = getHome(lang).closing.form;

const options = <T extends Record<string, { es: string; en: string }>>(list: T) =>
  Object.entries(list).map(([key, labels]) => ({ key, label: labels[lang] }));

const needs   = options(NEEDS);
const niches  = options(NICHES);
const timelines = options(TIMELINES);

// Clases compartidas
const q      = 'text-[22px] leading-[30px] tracking-[-0.015em] focus:outline-none max-sm:text-xl max-sm:leading-[27px]';
const chips  = 'mt-4 flex flex-wrap gap-2.5 max-sm:mt-3 max-sm:gap-2';
const chip   = 'cursor-pointer rounded-full border border-mar-line bg-transparent font-medium text-crema transition-all duration-300 hover:border-aqua-light aria-pressed:border-aqua aria-pressed:bg-aqua aria-pressed:text-mar aria-pressed:hover:border-aqua';
const field  = 'flex flex-col gap-2';
const label  = 'text-[13px] leading-5 text-ink-muted-dark';
const input  = 'min-h-12 w-full resize-y border border-mar-line bg-white/6 px-4 py-3 text-[15px] leading-[22px] text-crema transition-colors duration-200 placeholder:text-ink-muted-dark/60 focus:border-aqua-light focus:ring-1 focus:ring-aqua-light focus:outline-none user-invalid:border-error-light';
const error  = 'mt-3 text-sm leading-[21px] text-error-light empty:hidden';
const actions = 'mt-6 flex items-center justify-between gap-4 max-sm:flex-wrap-reverse';
const back   = 'link-u cursor-pointer border-0 bg-transparent py-2 text-[15px] text-ink-muted-dark hover:text-crema';
const next   = 'pill fill-btn inline-flex min-h-[52px] items-center justify-center gap-2.5 rounded-full bg-aqua px-7 text-base font-semibold whitespace-nowrap text-mar disabled:cursor-progress disabled:opacity-70 max-sm:w-full';
---
<!-- Sin JS queda oculto: el botón circular, el email y WhatsApp siguen disponibles -->
<div
  class="glass mt-20 max-w-[560px] rounded-[28px] p-8 text-crema max-sm:mt-[110px] max-sm:rounded-3xl max-sm:p-5"
  data-lead
  hidden
  data-step-tpl={f.step}
  data-success-tpl={f.successTitle}
  data-wa-tpl={f.waLead}
  data-wa-base={links.whatsapp}
  data-calendly-base={links.calendly}
  data-submitting={f.submitting}
  data-pick-one={f.pickOne}
  data-other-required={f.otherRequired}
  data-error={f.error}
>
  <div data-lead-top>
    <p class="text-xs leading-[18px] tracking-[.08em] text-ink-muted-dark uppercase" data-lead-step aria-live="polite">{f.step.replace('{n}', '1').replace('{t}', '3')}</p>
    <div class="mt-2.5 h-0.5 overflow-hidden rounded-full bg-cielo/18" aria-hidden="true"><div class="h-full w-full origin-left rounded-full bg-linear-to-r from-mediterraneo to-aqua transition-transform duration-[400ms] ease-brand [transform:scaleX(.33)]" data-lead-bar></div></div>
  </div>

  <form data-lead-form method="post" action="/api/contact" aria-label={f.label}>
    <div class="absolute -left-[9999px] size-px overflow-hidden" aria-hidden="true">
      <label for="lead-website">Website</label>
      <input id="lead-website" type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Paso 1 -->
    <div class="mt-6" data-pane="1">
      <p class={q} id="lead-need-q" data-q tabindex="-1">{f.needTitle}</p>
      <div class={chips} role="group" aria-labelledby="lead-need-q">
        {needs.map((o) => (
          <button type="button" class={`${chip} min-h-12 px-[22px] text-[15px] max-sm:min-h-11 max-sm:px-[18px] max-sm:text-sm`} aria-pressed="false" data-field="need" data-value={o.key} data-label={o.label}>{o.label}</button>
        ))}
      </div>
    </div>

    <!-- Paso 2 -->
    <div class="mt-6" data-pane="2" hidden>
      <p class={q} id="lead-niche-q" data-q tabindex="-1">{f.nicheTitle}</p>
      <div class={chips} role="group" aria-labelledby="lead-niche-q">
        {niches.map((o) => (
          <button type="button" class={`${chip} min-h-12 px-[22px] text-[15px] max-sm:min-h-11 max-sm:px-[18px] max-sm:text-sm`} aria-pressed="false" data-field="niche" data-value={o.key} data-label={o.label}>{o.label}</button>
        ))}
      </div>
      <div class={`${field} mt-4`} data-niche-other hidden>
        <label class={label} for="lead-niche-other">{f.nicheOther}</label>
        <input class={`${input} rounded-[10px]`} id="lead-niche-other" type="text" name="nicheOther" maxlength="80" placeholder={f.nicheOtherPh} autocomplete="organization-title" />
      </div>

      <p class="mt-6 text-base leading-6 tracking-[-0.015em]" id="lead-timeline-q">{f.timelineTitle}</p>
      <div class={chips} role="group" aria-labelledby="lead-timeline-q">
        {timelines.map((o) => (
          <button type="button" class={`${chip} min-h-11 px-[18px] text-sm`} aria-pressed="false" data-field="timeline" data-value={o.key} data-label={o.label}>{o.label}</button>
        ))}
      </div>

      <p class={error} data-pane-error role="alert"></p>
      <div class={actions}>
        <button type="button" class={back} data-back>{f.back}</button>
        <button type="button" class={next} data-next>{f.continue}<Icon name="arrow-right" /></button>
      </div>
    </div>

    <!-- Paso 3 -->
    <div class="mt-6" data-pane="3" hidden>
      <p class={q} id="lead-data-q" data-q tabindex="-1">{f.dataTitle}</p>
      <div class="mt-4 grid grid-cols-2 gap-4 max-sm:grid-cols-1">
        <div class={field}>
          <label class={label} for="lead-name">{f.name}</label>
          <input class={`${input} rounded-[10px]`} id="lead-name" type="text" name="name" required maxlength="100" autocomplete="name" />
        </div>
        <div class={field}>
          <label class={label} for="lead-email">{f.email}</label>
          <input class={`${input} rounded-[10px]`} id="lead-email" type="email" name="email" required maxlength="254" autocomplete="email" />
        </div>
        <div class={`${field} col-span-2 max-sm:col-span-1`}>
          <label class={label} for="lead-phone">{f.phone} <span class="text-[.85em]">{f.optional}</span></label>
          <div class="flex items-stretch">
            <span class="flex items-center rounded-l-[10px] border border-r-0 border-mar-line px-3 text-[15px] text-ink-muted-dark" aria-hidden="true">+57</span>
            <input class={`${input} rounded-r-[10px]`} id="lead-phone" type="tel" name="phone" maxlength="20" pattern="[0-9 +\-]*" inputmode="tel" autocomplete="tel-national" />
          </div>
        </div>
        <div class={`${field} col-span-2 max-sm:col-span-1`}>
          <label class={label} for="lead-message">{f.message} <span class="text-[.85em]">{f.optional}</span></label>
          <textarea class={`${input} rounded-[10px]`} id="lead-message" name="message" rows="3" maxlength="5000"></textarea>
        </div>
      </div>

      <p class={error} data-submit-error role="alert"></p>
      <div class={actions}>
        <button type="button" class={back} data-back>{f.back}</button>
        <button type="submit" class={next} data-submit><span data-submit-label>{f.submit}</span><Icon name="arrow-right" /></button>
      </div>
    </div>
  </form>

  <!-- Confirmación -->
  <div class="mt-6 flex flex-col items-start gap-4" data-lead-done hidden>
    <svg class="size-[52px] text-aqua" viewBox="0 0 52 52" aria-hidden="true" data-check>
      <circle class="[stroke-dasharray:151]" cx="26" cy="26" r="24" fill="none" stroke="currentColor" stroke-width="2" />
      <path class="[stroke-dasharray:36]" d="M15 27 l7 7 l15 -16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <p class="text-2xl leading-8 tracking-[-0.02em] focus:outline-none" data-done-title tabindex="-1"></p>
    <a class="btn pill fill-btn bg-aqua text-mar max-sm:w-full" href={links.calendly} data-calendly data-done-calendly data-track="calendly_open" data-track-place="form">
      {f.successCta}<Icon name="arrow-right" />
    </a>
    <a class="link-u inline-flex items-center gap-2 text-[15px] text-ink-muted-dark hover:text-crema" href={links.whatsapp} target="_blank" rel="noopener noreferrer" data-done-wa data-track="whatsapp" data-track-place="form">
      <Icon name="whatsapp" size={16} />{f.successWa}
    </a>
  </div>
</div>
