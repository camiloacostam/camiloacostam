---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import cutout from '../../assets/home/camilo-cutout.webp';
import avatar from '../../assets/home/camilo.webp';
import { getHome, links } from '../../data/home';
import { getLang } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const c    = getHome(lang).hero;
---
<section id="inicio" class="hero" data-nav="dark">
  <div class="blob blob--a" aria-hidden="true"></div>
  <div class="blob blob--b" aria-hidden="true"></div>

  <div class="wrap hero-grid">
    <div class="hero-intro">
      <div class="glass hero-badge"><span class="pulse"></span>{c.availability}</div>
      <h1 class="hero-title">{c.titleStart} <span class="script">{c.titleScript}</span></h1>
      <p class="hero-sub">{c.subline}</p>
    </div>

    <div class="hero-actions">
      <a class="hero-cta pill" href={links.calendly} data-calendly data-track="agendar" data-track-place="hero">
        {c.cta}
        <span class="hero-cta-arrow"><Icon name="arrow-right" class="arrow-cta" /></span>
      </a>
      <a class="link-u hero-secondary" href="#proyectos">{c.secondary}</a>
      <svg class="hero-scribble" aria-hidden="true" viewBox="0 0 120 70"><path d="M110 60 C 80 66, 40 58, 22 30 M22 30 l-2 14 M22 30 l13 5" fill="none" stroke="#2DD4BF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </div>

    <div class="hero-hello">
      <Image src={avatar} alt="" width={88} height={88} class="hero-avatar" />
      <p><span class="script hero-hello-name">{c.hello}</span><br />{c.role}</p>
    </div>

    <div class="hero-visual">
      <div class="halo" aria-hidden="true"></div>
      <div class="ring ring--a" aria-hidden="true"></div>
      <div class="ring ring--b" aria-hidden="true"></div>
      <Image
        src={cutout}
        alt={c.photoAlt}
        widths={[320, 430, 649]}
        sizes="(max-width: 640px) 310px, 430px"
        class="hero-photo"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-fade" aria-hidden="true"></div>

      <!-- Mockup de una web de ejemplo (psicóloga) -->
      <div class="phone-box" aria-hidden="true">
        <div class="phone">
          <div class="phone-screen">
            <div class="phone-notch"></div>
            <div class="phone-head"><span class="script">{c.phone.brand}</span><span class="phone-burger"></span></div>
            <p class="phone-title">{c.phone.title}</p>
            <p class="phone-desc">{c.phone.desc}</p>
            <span class="phone-cta">{c.phone.cta}</span>
            <div class="phone-media"></div>
            <div class="phone-review"><span class="phone-stars">★★★★★</span><p>{c.phone.review}</p></div>
            <span class="phone-wa"><Icon name="whatsapp" /></span>
          </div>
        </div>
      </div>

      <ul class="callouts">
        {c.callouts.map((k, i) => (
          <li class={`glass callout callout--${i + 1}`} style={`animation-delay: ${0.6 + i * 0.2}s`}>
            <span class="callout-num">{String(i + 1).padStart(2, '0')}</span>
            <span><span class="callout-title">{k.title}</span><span class="callout-desc">{k.desc}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="wrap hero-meta">
    <span class="meta-side">{c.location}</span>
    <span class="hero-scroll">{c.scroll}<span class="scroll-line"></span></span>
    <span class="meta-side">{c.delivered}</span>
  </div>
</section>

<style>
  .hero {
    position: relative; min-height: 920px; background: var(--mar); color: var(--crema);
    overflow: hidden; display: flex; flex-direction: column;
  }
  .blob--a { width: 620px; height: 620px; right: 4%; top: -120px; background: var(--mediterraneo); }
  .blob--b { width: 420px; height: 420px; right: 30%; bottom: -80px; background: var(--aqua); opacity: .3; animation-delay: -6s; }

  .hero-grid {
    position: relative; width: 100%; flex-grow: 1; padding-top: 140px; padding-bottom: 32px;
    display: grid; column-gap: 24px; align-items: center;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: auto auto auto;
    grid-template-areas: 'intro visual' 'actions visual' 'hello visual';
    align-content: center;
  }
  .hero-intro   { grid-area: intro; align-self: end; }
  .hero-actions { grid-area: actions; }
  .hero-hello   { grid-area: hello; align-self: start; }
  .hero-visual  { grid-area: visual; }

  .hero-badge {
    display: inline-flex; align-items: center; gap: 10px; padding: 8px 16px 8px 12px;
    border-radius: 9999px; font-size: 13px; line-height: 20px; color: var(--cielo-soft);
  }
  .hero-title { margin-top: 28px; font-size: 64px; line-height: 68px; font-weight: 400; letter-spacing: -0.035em; }
  .hero-title .script { font-size: 84px; color: var(--aqua); }
  .hero-sub { margin-top: 24px; max-width: 440px; font-size: 18px; line-height: 29px; color: var(--ink-muted-dark); }

  .hero-actions { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 36px; }
  .hero-cta {
    display: inline-flex; align-items: center; gap: 14px; min-height: 60px; padding: 0 8px 0 26px;
    border-radius: 9999px; background: var(--crema); color: var(--mar); font-weight: 600; font-size: 16px; text-decoration: none;
  }
  .hero-cta-arrow {
    width: 44px; height: 44px; border-radius: 9999px; background: var(--mediterraneo); color: #FFFFFF;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .hero-cta :global(.arrow-cta) { transition: transform .4s var(--ease); }
  .hero-cta:hover :global(.arrow-cta) { transform: translateX(4px) rotate(-45deg); }
  .hero-secondary { color: var(--crema); font-size: 15px; }
  .hero-scribble { position: absolute; left: 250px; top: 58px; width: 110px; height: 64px; pointer-events: none; }

  .hero-hello { display: flex; align-items: center; gap: 12px; margin-top: 64px; }
  .hero-hello p { font-size: 14px; line-height: 20px; color: #C9D8E8; }
  .hero-hello-name { font-size: 20px; color: var(--crema); }
  .hero-avatar {
    width: 44px; height: 44px; border-radius: 9999px; object-fit: cover; object-position: 50% 12%;
    border: 1px solid rgba(255,255,255,.25); background: var(--cielo);
  }

  /* Visual */
  .hero-visual { position: relative; width: 620px; max-width: 100%; height: 680px; justify-self: center; }
  .halo {
    position: absolute; left: 100px; top: 40px; width: 480px; height: 480px; border-radius: 9999px;
    background: radial-gradient(circle, rgba(159,211,242,.55) 0%, rgba(29,95,174,.35) 45%, rgba(10,35,66,0) 72%);
  }
  .ring { position: absolute; border-radius: 9999px; }
  .ring--a { left: 140px; top: 80px; width: 400px; height: 400px; border: 1px solid rgba(94,234,212,.35); }
  .ring--b { left: 196px; top: 136px; width: 288px; height: 288px; border: 1px dashed rgba(159,211,242,.25); }
  .hero-photo {
    position: absolute; left: 125px; bottom: 0; width: 430px; height: auto;
    filter: drop-shadow(0 30px 40px rgba(0,0,0,.35));
  }
  .hero-fade {
    position: absolute; left: 60px; right: 0; bottom: 0; height: 130px;
    background: linear-gradient(to top, var(--mar) 10%, rgba(10,35,66,0));
  }

  .phone-box { position: absolute; left: 0; top: 318px; width: 280px; height: 580px; transform: scale(.6); transform-origin: top left; }
  .phone {
    position: absolute; inset: 0; border-radius: 44px; background: var(--mar-raised);
    border: 1px solid rgba(255,255,255,.22); padding: 10px;
    box-shadow: 0 50px 100px -30px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.25);
    animation: phone 7s ease-in-out infinite;
  }
  @keyframes phone { 0%, 100% { transform: rotate(-4deg) translateY(0); } 50% { transform: rotate(-4deg) translateY(-14px); } }
  .phone-screen {
    position: relative; height: 100%; border-radius: 34px; background: var(--crema); overflow: hidden;
    padding: 40px 18px 18px; color: var(--mar); font-size: 10px; line-height: 14px;
  }
  .phone-notch { position: absolute; top: 10px; left: 50%; transform: translateX(-50%); width: 80px; height: 22px; border-radius: 9999px; background: var(--mar-raised); }
  .phone-head { display: flex; justify-content: space-between; align-items: center; }
  .phone-head .script { font-size: 15px; }
  .phone-burger { width: 16px; height: 2px; background: var(--mar); box-shadow: 0 5px 0 var(--mar); }
  .phone-title { margin-top: 22px; font-size: 21px; line-height: 23px; font-weight: 500; letter-spacing: -0.03em; }
  .phone-desc { margin-top: 8px; color: var(--ink-muted); }
  .phone-cta { margin-top: 14px; display: inline-flex; padding: 8px 14px; border-radius: 9999px; background: var(--aqua); font-weight: 600; }
  .phone-media { margin-top: 16px; height: 140px; border-radius: 16px; background: linear-gradient(160deg, var(--cielo), var(--mediterraneo)); }
  .phone-review { margin-top: 14px; padding: 10px 12px; border-radius: 14px; background: var(--crema-raised); border: 1px solid var(--line); }
  .phone-review p { margin-top: 4px; color: var(--ink-muted); }
  .phone-stars { color: var(--mediterraneo); letter-spacing: 1px; }
  .phone-wa {
    position: absolute; right: 14px; bottom: 16px; width: 38px; height: 38px; border-radius: 9999px;
    background: var(--disponible); color: var(--mar); display: flex; align-items: center; justify-content: center;
  }

  .callouts { list-style: none; }
  .callout {
    position: absolute; width: 214px; display: flex; align-items: center; gap: 12px; padding: 12px 14px;
    border-radius: 18px; opacity: 0; animation: callin .8s var(--ease) forwards;
  }
  .callout--1 { left: 0; top: 120px; }
  .callout--2 { right: 0; top: 262px; }
  .callout--3 { right: 16px; top: 500px; }
  @keyframes callin { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .callout { opacity: 1; } }
  .callout-num {
    flex-shrink: 0; width: 30px; height: 30px; border-radius: 9999px; background: rgba(45,212,191,.18);
    color: var(--aqua-light); font-size: 12px; font-weight: 600; display: flex; align-items: center; justify-content: center;
  }
  .callout-title { display: block; font-size: 14px; line-height: 18px; font-weight: 600; color: #FFFFFF; }
  .callout-desc { display: block; font-size: 12px; line-height: 16px; color: #C9D8E8; }

  .hero-meta {
    position: relative; width: 100%; display: flex; justify-content: space-between; align-items: flex-end;
    gap: 16px; padding-bottom: 28px; font-size: 11px; line-height: 16px; letter-spacing: .12em;
    text-transform: uppercase; color: var(--ink-muted-dark);
  }
  .hero-scroll { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .scroll-line {
    display: block; width: 1px; height: 32px; background: var(--aqua);
    animation: scrollline 2.2s ease-in-out infinite; transform-origin: top;
  }
  @keyframes scrollline {
    0% { transform: scaleY(0); } 50% { transform: scaleY(1); transform-origin: top; }
    51% { transform-origin: bottom; } 100% { transform: scaleY(0); transform-origin: bottom; }
  }

  @media (max-width: 960px) {
    .hero { min-height: 0; }
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'intro' 'visual' 'actions' 'hello';
      padding-top: 120px;
    }
    .hero-visual { transform: scale(.82); margin: -40px auto -60px; }
    .callouts { display: none; }
    .hero-actions { margin-top: 8px; }
    .hero-hello { margin-top: 32px; }
  }

  @media (max-width: 640px) {
    .hero-grid { padding-top: 100px; padding-bottom: 28px; }
    .hero-badge { gap: 8px; padding: 6px 14px 6px 10px; font-size: 12px; }
    .hero-title { margin-top: 20px; font-size: 42px; line-height: 45px; }
    .hero-title .script { font-size: 56px; }
    .hero-sub { margin-top: 16px; font-size: 16px; line-height: 25px; }

    /* Visual móvil: foto centrada, móvil pequeño a la izquierda y píldoras a la derecha */
    .hero-visual { width: auto; max-width: none; height: 430px; margin: 16px -16px 0; transform: none; justify-self: stretch; }
    .halo { left: 50%; top: 20px; width: 360px; height: 360px; margin-left: -180px; }
    .ring--a { left: 50%; top: 50px; width: 300px; height: 300px; margin-left: -150px; }
    .ring--b { display: none; }
    .hero-photo { left: 50%; width: 310px; margin-left: -140px; }
    .hero-fade { left: 0; height: 90px; }
    .phone-box { left: 14px; top: 196px; transform: scale(.42); }
    .phone { animation-name: phone-m; }
    @keyframes phone-m { 0%, 100% { transform: rotate(-5deg) translateY(0); } 50% { transform: rotate(-5deg) translateY(-10px); } }

    .callouts { display: block; }
    .callout { width: auto; right: 12px; left: auto; gap: 8px; padding: 8px 12px 8px 8px; border-radius: 9999px; }
    .callout--1 { top: 70px; }
    .callout--2 { top: 210px; }
    .callout--3 { top: 330px; }
    .callout-num { width: 24px; height: 24px; font-size: 10px; background: rgba(45,212,191,.2); }
    .callout-title { font-size: 13px; }
    .callout-desc { display: none; }

    .hero-actions { flex-direction: column; align-items: stretch; gap: 12px; }
    .hero-cta { justify-content: space-between; min-height: 58px; padding: 0 7px 0 24px; }
    .hero-secondary, .hero-scribble { display: none; }
    .hero-hello { margin-top: 12px; padding: 6px 4px; gap: 10px; }
    .hero-hello p { font-size: 13px; line-height: 18px; }
    .hero-hello-name { font-size: 18px; }
    .hero-avatar { width: 40px; height: 40px; }

    .hero-meta { display: none; }
  }
</style>
