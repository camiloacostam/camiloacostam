---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import cutout from '../../assets/home/camilo-cutout.webp';
import avatar from '../../assets/home/camilo.webp';
import { getHome, isPending, links } from '../../data/home';
import { getLang } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const c    = getHome(lang).hero;

// Posición de cada tarjeta: escritorio / móvil (píldoras a la derecha)
const calloutPos = [
  'top-[120px] left-0 max-sm:top-[70px]',
  'top-[262px] right-0 max-sm:top-[210px]',
  'top-[500px] right-4 max-sm:top-[330px]',
];
---
<section id="inicio" class="relative flex min-h-[920px] flex-col overflow-hidden bg-mar text-crema max-lg:min-h-0" data-nav="dark">
  <div class="blob top-[-120px] right-[4%] size-[620px] bg-mediterraneo" aria-hidden="true"></div>
  <div class="blob right-[30%] -bottom-20 size-[420px] bg-aqua opacity-30! [animation-delay:-6s]" aria-hidden="true"></div>

  <div class="wrap relative grid w-full grow grid-cols-[minmax(0,5fr)_minmax(0,7fr)] grid-rows-[auto_auto_auto] content-center items-center gap-x-6 pt-[140px] pb-8 max-lg:grid-cols-1 max-lg:pt-[120px] max-sm:pt-[100px] max-sm:pb-7">
    <div class="col-start-1 row-start-1 self-end">
      {!isPending(c.availability) && <div class="glass inline-flex items-center gap-2.5 rounded-full py-2 pr-4 pl-3 text-[13px] leading-5 text-cielo-soft max-sm:gap-2 max-sm:py-1.5 max-sm:pr-3.5 max-sm:pl-2.5 max-sm:text-xs"><span class="pulse-dot"></span>{c.availability}</div>}
      <h1 class="mt-7 text-[64px] first:mt-0 leading-[68px] font-normal tracking-[-0.035em] max-sm:mt-5 max-sm:text-[42px] max-sm:leading-[45px]">{c.titleStart} <span class="script text-[84px] text-aqua max-sm:text-[56px]">{c.titleScript}</span></h1>
      <p class="mt-6 max-w-[440px] text-lg leading-[29px] text-ink-muted-dark max-sm:mt-4 max-sm:text-base max-sm:leading-[25px]">{c.subline}</p>
    </div>

    <div class="relative col-start-1 row-start-2 mt-9 flex flex-wrap items-center gap-5 max-lg:row-start-3 max-lg:mt-2 max-sm:flex-col max-sm:items-stretch max-sm:gap-3">
      <a class="pill breathe group/cta inline-flex min-h-[60px] items-center gap-3.5 rounded-full bg-crema pr-2 pl-[26px] text-base font-semibold text-mar no-underline max-sm:min-h-[58px] max-sm:justify-between max-sm:pr-[7px] max-sm:pl-6" href={links.booking} data-booking data-track="agendar" data-track-place="hero">
        {c.cta}
        <span class="inline-flex size-11 items-center justify-center rounded-full bg-mediterraneo text-white"><Icon name="arrow-right" class="transition-transform duration-[400ms] ease-brand group-hover/cta:translate-x-1 group-hover/cta:-rotate-45" /></span>
      </a>
      <a class="link-u text-[15px] text-crema max-sm:hidden" href="#proyectos">{c.secondary}</a>
      <svg class="pointer-events-none absolute top-[58px] left-[250px] h-16 w-[110px] text-aqua max-sm:hidden" aria-hidden="true" viewBox="0 0 120 70"><path class="animate-wire [stroke-dasharray:220] [stroke-dashoffset:220] motion-reduce:[stroke-dashoffset:0]" d="M110 60 C 80 66, 40 58, 22 30 M22 30 l-2 14 M22 30 l13 5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </div>

    <div class="col-start-1 row-start-3 mt-16 flex items-center gap-3 self-start max-lg:row-start-4 max-lg:mt-8 max-sm:mt-3 max-sm:gap-2.5 max-sm:px-1 max-sm:py-1.5">
      <Image src={avatar} alt="" width={88} height={88} class="size-11 rounded-full border border-white/25 bg-cielo object-cover object-[50%_12%] max-sm:size-10" />
      <p class="text-sm leading-5 text-ink-muted-dark max-sm:text-[13px] max-sm:leading-[18px]"><span class="script text-xl text-crema max-sm:text-lg">{c.hello}</span><br />{c.role}{!isPending(c.roleYears) && ` · ${c.roleYears}`}</p>
    </div>

    <div class="relative col-start-2 row-span-3 row-start-1 h-[680px] w-[620px] max-w-full justify-self-center max-lg:col-start-1 max-lg:row-span-1 max-lg:row-start-2 max-lg:mx-auto max-lg:-mt-10 max-lg:-mb-[60px] max-lg:scale-[.82] max-sm:mx-[-16px] max-sm:mt-4 max-sm:mb-0 max-sm:h-[430px] max-sm:w-auto max-sm:max-w-none max-sm:scale-100 max-sm:justify-self-stretch">
      <div class="absolute top-10 left-[100px] size-[480px] rounded-full bg-radial from-cielo/55 from-0% via-mediterraneo/35 via-45% to-mar/0 to-72% max-sm:top-5 max-sm:left-1/2 max-sm:-ml-[180px] max-sm:size-[360px]" aria-hidden="true"></div>
      <div class="absolute top-20 left-[140px] size-[400px] rounded-full border border-aqua-light/35 max-sm:top-[50px] max-sm:left-1/2 max-sm:-ml-[150px] max-sm:size-[300px]" aria-hidden="true"></div>
      <div class="absolute top-[136px] left-[196px] size-72 rounded-full border border-dashed border-cielo/25 max-sm:hidden" aria-hidden="true"></div>
      <Image
        src={cutout}
        alt={c.photoAlt}
        widths={[320, 430, 649]}
        sizes="(max-width: 640px) 310px, 430px"
        class="absolute bottom-0 left-[125px] h-auto w-[430px] drop-shadow-[0_30px_40px_rgb(0_0_0/.35)] max-sm:left-1/2 max-sm:-ml-[140px] max-sm:w-[310px]"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute right-0 bottom-0 left-[60px] h-[130px] bg-linear-to-t from-mar from-10% to-mar/0 max-sm:left-0 max-sm:h-[90px]" aria-hidden="true"></div>

      <!-- Mockup de una web de ejemplo (consultorio) con su agenda en línea -->
      <div class="absolute top-[318px] left-0 h-[580px] w-[280px] origin-top-left scale-60 max-sm:top-[196px] max-sm:left-3.5 max-sm:scale-[.42]" aria-hidden="true">
        <div class="absolute inset-0 animate-phone rounded-[44px] border border-white/20 bg-mar-raised p-2.5 shadow-[0_50px_100px_-30px_rgb(0_0_0/.6),inset_0_1px_0_rgb(255_255_255/.25)] max-sm:animate-phone-m">
          <div class="relative h-full overflow-hidden rounded-[34px] bg-crema px-[18px] pt-10 pb-[18px] text-[10px] leading-[14px] text-mar">
            <div class="absolute top-2.5 left-1/2 h-[22px] w-20 -translate-x-1/2 rounded-full bg-mar-raised"></div>
            <div class="flex items-center justify-between"><span class="script text-[15px]">{c.phone.brand}</span><span class="h-0.5 w-4 bg-mar shadow-[0_5px_0_rgb(10_35_66)]"></span></div>
            <p class="mt-[22px] text-[21px] leading-[23px] font-medium tracking-[-0.03em]">{c.phone.title}</p>
            <p class="mt-2 text-ink-muted">{c.phone.desc}</p>
            <span class="mt-3.5 inline-flex rounded-full bg-aqua px-3.5 py-2 font-semibold">{c.phone.cta}</span>
            <div class="mt-4 h-[140px] rounded-2xl bg-linear-160 from-cielo to-mediterraneo"></div>
            <div class="mt-3.5 flex items-center justify-between gap-2 rounded-[14px] border border-line bg-crema-raised px-3 py-2.5"><div><span class="font-semibold text-mediterraneo">{c.phone.bookingLabel}</span><p class="mt-1 text-ink-muted">{c.phone.bookingSlot}</p></div><span class="rounded-full bg-mediterraneo px-2.5 py-1 font-semibold text-white">{c.phone.bookingCta}</span></div>
            <span class="absolute right-3.5 bottom-4 flex size-[38px] items-center justify-center rounded-full bg-disponible text-mar"><Icon name="whatsapp" /></span>
          </div>
        </div>
      </div>

      <ul class="max-lg:hidden max-sm:block">
        {c.callouts.map((k, i) => (
          <li
            class:list={[
              'glass absolute flex w-[214px] animate-callin items-center gap-3 rounded-[18px] px-3.5 py-3 opacity-0 motion-reduce:opacity-100',
              'max-sm:right-3 max-sm:left-auto max-sm:w-auto max-sm:gap-2 max-sm:rounded-full max-sm:py-2 max-sm:pr-3 max-sm:pl-2',
              calloutPos[i],
            ]}
            style={`animation-delay: ${0.6 + i * 0.2}s`}
          >
            <span class="flex size-[30px] shrink-0 items-center justify-center rounded-full bg-aqua/18 text-xs font-semibold text-aqua-light max-sm:size-6 max-sm:bg-aqua/20 max-sm:text-[10px]">{String(i + 1).padStart(2, '0')}</span>
            <span><span class="block text-sm leading-[18px] font-semibold text-white max-sm:text-[13px]">{k.title}</span><span class="block text-xs leading-4 text-ink-muted-dark max-sm:hidden">{k.desc}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="wrap relative flex w-full items-end justify-between gap-4 pb-7 text-[11px] leading-4 tracking-[.12em] text-ink-muted-dark uppercase max-sm:hidden">
    <span>{c.location}</span>
    <span class="flex flex-col items-center gap-2.5">{c.scroll}<span class="block h-8 w-px origin-top animate-scrollline bg-aqua"></span></span>
    {c.delivered ? <span>{c.delivered}</span> : <span aria-hidden="true"></span>}
  </div>
</section>

<!-- Keyframes exclusivos del hero (mover a @theme --animate-* en app.css cuando se integre) -->
