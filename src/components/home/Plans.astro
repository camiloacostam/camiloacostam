---
import { getHome, links } from '../../data/home';
import { getLang } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const c    = getHome(lang).plans;

const price = 'mt-5 text-[22px] leading-7 font-medium tracking-[-0.02em]';
const cta   = 'inline-flex items-center justify-center rounded-full bg-aqua px-[22px] text-[15px] font-semibold text-mar';
---
<section id="paquetes" class="py-40 max-sm:pt-[88px] max-sm:pb-[72px]" data-nav="light">
  <div class="wrap max-sm:px-0!">
    <div class="flex flex-wrap items-end justify-between gap-6 max-sm:mx-5 max-sm:block">
      <h2 class="h-section reveal">{c.title}</h2>
      <p class="max-w-[380px] text-[15px] leading-6 text-ink-muted max-sm:mt-3 max-sm:max-w-none max-sm:text-sm max-sm:leading-[21px]">{c.intro}</p>
    </div>

    <!-- Móvil: carrusel con snap y puntos -->
    <div class="mt-14 grid grid-cols-3 gap-4 max-lg:grid-cols-2 max-sm:mt-6 max-sm:flex max-sm:snap-x max-sm:snap-mandatory max-sm:gap-2.5 max-sm:overflow-x-auto max-sm:px-5 max-sm:py-1 max-sm:[scrollbar-width:none] max-sm:[&::-webkit-scrollbar]:hidden" data-plans>
      {c.items.map((p, i) => {
        const muted = p.featured ? 'text-cielo-soft' : 'text-ink-muted';
        return (
          <a
            class:list={[
              'reveal group/plan flex min-h-[520px] flex-col rounded-3xl p-8 no-underline transition-[background,color] duration-[450ms] hover:bg-mar hover:text-crema max-sm:min-h-0 max-sm:shrink-0 max-sm:grow-0 max-sm:basis-[300px] max-sm:snap-center max-sm:p-6',
              p.featured ? 'bg-mediterraneo text-white' : 'bg-crema-raised text-mar',
            ]}
            href={links.booking}
            data-booking
            data-track="agendar"
            data-track-place={`paquete-${i + 1}`}
          >
            <p class="text-[22px] leading-[30px] font-medium max-sm:text-xl">{p.name}{p.badge && <span class="ml-1.5 rounded-full bg-white/18 px-2.5 py-1 align-middle text-xs leading-[18px] font-semibold max-sm:px-[9px] max-sm:py-[3px] max-sm:text-[11px]">{p.badge}</span>}</p>
            <p class:list={['mt-2 text-[15px] leading-[23px] transition-colors duration-[450ms] group-hover/plan:text-ink-muted-dark max-sm:text-sm max-sm:leading-[21px]', muted]}>{p.desc}</p>
            <p class:list={['mt-6 text-xs tracking-[.08em] uppercase transition-colors duration-[450ms] group-hover/plan:text-ink-muted-dark', muted]}>{c.includesLabel}</p>
            <ul class="mt-2.5 flex flex-col gap-2 text-[15px] leading-[22px]">
              {p.includes.map((item) => (
                <li class="flex gap-2.5 max-sm:nth-4:hidden">
                  <span class:list={['font-bold transition-colors duration-[450ms] group-hover/plan:text-aqua-light', p.featured ? 'text-aqua-light' : 'text-mediterraneo']} aria-hidden="true">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <div class:list={['mt-auto grid grid-cols-[auto_minmax(0,1fr)] gap-x-3 gap-y-1 pt-6 text-sm leading-[21px] transition-colors duration-[450ms] group-hover/plan:text-ink-muted-dark', muted]}>
              <span>{c.deliveryLabel}</span><strong class="font-semibold">{p.delivery}</strong>
              <span>{c.resultLabel}</span><strong class="font-semibold">{p.result}</strong>
            </div>
            <p class={price}>{p.price}{p.per && <span class="text-base">{p.per}</span>}</p>
            <span class={`${cta} mt-4 min-h-[52px]`}>{c.cta}</span>
          </a>
        );
      })}
    </div>
    <div class="mt-4 hidden justify-center gap-1.5 max-sm:flex" aria-hidden="true" data-plan-dots>
      {c.items.map((_, i) => <span class:list={['size-1.5 rounded-full bg-line transition-all duration-300 [&.is-active]:w-5 [&.is-active]:bg-mediterraneo', { 'is-active': i === 0 }]}></span>)}
    </div>
  </div>
</section>
