---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SiteNav from '../../../components/site/SiteNav.astro';
import SiteFooter from '../../../components/site/SiteFooter.astro';
import PostPage from '../../../components/blog/PostPage.astro';
import { blogPage } from '../../../data/blog-page';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const copy = blogPage.en.post;
---
<Layout title={`${post.data.title} — ${copy.titleSuffix}`} description={post.data.excerpt} lang="en" variant="funnel">
  <SiteNav current="blog" tone="light" />
  <PostPage post={post} />
  <SiteFooter tone="light" />
</Layout>
