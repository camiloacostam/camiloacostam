---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/site/SiteNav.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import NotFoundPage from '../components/blog/NotFoundPage.astro';
import { blogPage } from '../data/blog-page';

const copy = blogPage.es.notFound;
---
<Layout title={`${copy.title} — Camilo Acosta`} description={copy.desc} noIndex>
  <SiteNav tone="light" />
  <NotFoundPage />
  <SiteFooter tone="light" />
</Layout>
