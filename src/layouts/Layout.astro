---
import '../styles/app.css';
import { links } from '../data/home';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  ogImage?: string;
  noIndex?: boolean;
  /** false = page exists in one language only: no hreflang alternates */
  alternates?: boolean;
}

const {
  title = 'Camilo Acosta — Diseño & Desarrollo Web en Cartagena',
  description = 'Diseñador y desarrollador web en Cartagena, Colombia. Webs y landing pages para profesionales independientes: psicólogos, odontólogos, coaches y más. Diseño, desarrollo y textos en un solo lugar.',
  lang = 'es',
  ogImage = '/og-image.jpg',
  noIndex = false,
  alternates = true,
} = Astro.props;

const fontsURL = 'https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600&family=Dancing+Script:wght@700&display=swap';

// Umami: solo se carga si existe PUBLIC_UMAMI_WEBSITE_ID (en .env y en Cloudflare Pages)
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const isEnglish = lang === 'en';
const pathnameBase = Astro.url.pathname.replace(/^\/en/, '') || '/';
const esURL = new URL(pathnameBase, Astro.site);
const enURL = new URL('/en' + pathnameBase, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Camilo Acosta',
  url: 'https://camiloacosta.dev',
  jobTitle: isEnglish ? 'Web Designer & Developer' : 'Diseñador y desarrollador web',
  description: isEnglish
    ? 'Websites and landing pages for independent professionals that want to get booked.'
    : 'Webs y landing pages para profesionales independientes que quieren que los agenden.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Cartagena',
    addressRegion: 'Bolívar',
    addressCountry: 'CO',
  },
  sameAs: [links.linkedin, links.instagram, links.x, links.github],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="diseñador web Cartagena, landing page Colombia, desarrollo web Cartagena, web para profesionales independientes, landing page para psicólogos, web para odontólogos, diseño web freelance Colombia, Camilo Acosta" />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />

    <!-- hreflang -->
    {alternates && (
      <>
        <link rel="alternate" hreflang="es" href={esURL} />
        <link rel="alternate" hreflang="en" href={enURL} />
        <link rel="alternate" hreflang="x-default" href={esURL} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={isEnglish ? 'en_US' : 'es_CO'} />
    <meta property="og:site_name" content="Camilo Acosta" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:creator" content="@camiloacostam" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Fuentes sin bloquear el render (display=swap muestra la fuente de sistema mientras cargan) -->
    <link rel="preload" as="style" href={fontsURL} />
    <link rel="stylesheet" href={fontsURL} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontsURL} /></noscript>

    <!-- Analítica (Umami): sin la variable de entorno no se carga nada -->
    {umamiId && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={umamiId}></script>}

    <!-- Schema.org JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="funnel">
    <slot />

    <!-- Analítica en todas las páginas + Cal.com (el embed se carga con el primer clic en un botón [data-booking]) -->
    <script>
      import { initTracking } from '../scripts/track';
      import { initBookingButtons } from '../scripts/cal';
      initTracking();
      initBookingButtons();
    </script>
  </body>
</html>
